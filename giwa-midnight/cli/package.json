{
  "name": "zkloan-credit-scorer-cli",
  "version": "0.1.0",
  "author": "Midnight Foundation",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preprod-remote": "node scripts/refuse-preprod.mjs",
    "standalone": "node --experimental-specifier-resolution=node --loader ts-node/esm src/standalone.ts",
    "proof-bridge": "node --experimental-specifier-resolution=node --loader ts-node/esm src/standalone-proof-bridge.ts",
    "test-api": "docker compose -f standalone.yml pull && DEBUG='testcontainers' vitest run",
    "test-against-preprod": "node scripts/refuse-preprod.mjs",
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start-preprod-remote": "node scripts/refuse-preprod.mjs",
    "demo": "node dist/hosted-demo.js",
    "test-demo": "vitest run src/test/hosted-demo*.test.ts",
    "demo:proof-check": "node dist/hosted-demo/proof-check.js"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "zkloan-credit-scorer-contract": "*",
    "giwa-midnight-api": "0.1.0",
    "zkloan-credit-scorer-attestation-api": "0.1.0"
  }
}
