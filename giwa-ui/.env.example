# Hosted synthetic Preview demo: same API origin serves the proof gateway.
# Never place capabilities,
# financial inputs, signatures, PINs, mnemonics, or private-state passwords in VITE_* variables.
VITE_MIDNIGHT_POC_ENABLED=true
VITE_MIDNIGHT_API_URL=/midnight-api
VITE_MIDNIGHT_PROOF_BRIDGE_ENABLED=true
VITE_MIDNIGHT_PROOF_API_URL=/midnight-proof
VITE_MIDNIGHT_DEMO_ENABLED=true

# Existing public Seller/Buyer/Funder accounts for filming with real MetaMask.
# Enable together with backend RECORDING_DEMO_ENABLED; walletless demo is unchanged.
VITE_RECORDING_DEMO_ENABLED=false
